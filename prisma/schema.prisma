generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Users {
  id         Int     @id @default(autoincrement())
  password   String?
  fullname   String
  surname    String
  student_id String  @unique
  faculty    String
  department String
  role       Role    @default(USER)

  club_apply Club_Apply[]
  user_club  User_Clubs[]
}

enum Role {
  ADMIN
  USER
}

model Club_Apply {
  id        Int      @id @default(autoincrement())
  user_id   Int
  club_id   String
  status    Status   @default(PENDING)
  create_at DateTime @default(now())

  user Users @relation(fields: [user_id], references: [id])
}

enum Status {
  APPROVE
  PENDING
  REJECT
}

model User_Clubs {
  id      Int    @id @default(autoincrement())
  user_id Int
  club_id String

  user Users @relation(fields: [user_id], references: [id])
}
